# Smart Attendance System Configuration

# Database
DATABASE_URL=sqlite:///./attendance_final.db

# Authentication / Security
SECRET_KEY=replace-with-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Paths
YOLO_MODEL_PATH=models/yolo26_face/best.pt
ANTISPOOF_MODEL_PATH=anti_spoofing/models/MiniFASNetV2.onnx
DATASET_DIR=dataset

# Pipeline Thresholds
REAL_CLASS_INDEX=1
LIVENESS_THRESHOLD=0.50
FACE_RECOGNITION_THRESHOLD=0.40
FACE_RECOGNITION_MODEL=Facenet

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False
